@using System.Linq
@model VTBL.ExportMessage.Rabbit.UI.Pages.KkaModel

<nav class="kka-pagination" aria-label="Навигация по страницам KKA">
    <ul class="pagination pagination-sm flex-wrap mb-2">
        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            @if (Model.HasPrevious)
            {
                <a class="page-link" asp-page="Kka" asp-route-pageNumber="@(Model.Page - 1)" asp-route-id="@Model.FilterIdForRoute" asp-route-operationKey="@Model.FilterOperationKeyForRoute" aria-label="Предыдущая">Назад</a>
            }
            else
            {
                <span class="page-link">Назад</span>
            }
        </li>
        @if (Model.GetVisiblePageNumbers().FirstOrDefault() > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-page="Kka" asp-route-pageNumber="1" asp-route-id="@Model.FilterIdForRoute" asp-route-operationKey="@Model.FilterOperationKeyForRoute">1</a>
            </li>
            @if (Model.GetVisiblePageNumbers().FirstOrDefault() > 2)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
        }
        @foreach (var pageNumber in Model.GetVisiblePageNumbers())
        {
            <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                <a class="page-link" asp-page="Kka" asp-route-pageNumber="@pageNumber" asp-route-id="@Model.FilterIdForRoute" asp-route-operationKey="@Model.FilterOperationKeyForRoute">@pageNumber</a>
            </li>
        }
        @if (Model.GetVisiblePageNumbers().LastOrDefault() < Model.TotalPages)
        {
            @if (Model.GetVisiblePageNumbers().LastOrDefault() < Model.TotalPages - 1)
            {
                <li class="page-item disabled"><span class="page-link">…</span></li>
            }
            <li class="page-item">
                <a class="page-link" asp-page="Kka" asp-route-pageNumber="@Model.TotalPages" asp-route-id="@Model.FilterIdForRoute" asp-route-operationKey="@Model.FilterOperationKeyForRoute">@Model.TotalPages</a>
            </li>
        }
        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            @if (Model.HasNext)
            {
                <a class="page-link" asp-page="Kka" asp-route-pageNumber="@(Model.Page + 1)" asp-route-id="@Model.FilterIdForRoute" asp-route-operationKey="@Model.FilterOperationKeyForRoute" aria-label="Следующая">Вперёд</a>
            }
            else
            {
                <span class="page-link">Вперёд</span>
            }
        </li>
    </ul>
</nav>
