@*
    Пункты навигации по интеграционным системам в navbar.
    Подписи берутся из IntegrationSystemInfo, маршруты — явные asp-page.
*@
@using VTBL.ExportMessage.Rabbit.UI.Models

@* Три фиксированные интеграции; DisplayName — единый источник подписи в UI. *@
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="" asp-page="/Kka">@IntegrationSystemInfo.Kka.DisplayName</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="" asp-page="/Nova">@IntegrationSystemInfo.Nova.DisplayName</a>
</li>
<li class="nav-item">
    <a class="nav-link text-dark" asp-area="" asp-page="/Remarketing">@IntegrationSystemInfo.Remarketing.DisplayName</a>
</li>
