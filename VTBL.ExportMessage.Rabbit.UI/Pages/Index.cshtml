@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4 p-lg-5">
        <h1 class="display-5 mb-3">Добро пожаловать в VTBL ExportMessage Rabbit</h1>
        <p class="lead mb-4">
            Вы находитесь в сервисе мониторинга и анализа сообщений RabbitMQ. Здесь можно быстро найти нужную Task,
            проверить историю статусов, увидеть ошибки обработки и содержимое сообщений.
        </p>

        <h2 class="h5 mb-3">Что делать дальше</h2>
        <ol class="mb-4">
            <li>Перейдите в раздел <strong>ККА</strong>.</li>
            <li>Для интеграций <strong>NOVA</strong> и <strong>Remarketing</strong> — соответствующие разделы в меню.</li>
            <li>Задайте фильтры: <code>Id</code>, <code>OperationKey</code>, диапазон <code>Created</code>, наличие <code>Error</code> или <code>SendMessage</code>.</li>
            <li>Откройте найденную запись и проверьте Body, историю статусов и детали ошибок.</li>
        </ol>

        <h2 class="h5 mb-3">Сводка по KKA</h2>
        @if (!string.IsNullOrEmpty(Model.KkaStatsError))
        {
            <div class="alert alert-warning mb-3" role="alert">@Model.KkaStatsError</div>
        }
        <div class="row mb-4">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <div class="text-muted small">Всего записей</div>
                        <div class="h3 mb-0">@Model.KkaStats.Total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted small">Успешных (без Error)</div>
                        <div class="h3 mb-0 text-success">@Model.KkaStats.Successful</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-danger">
                    <div class="card-body">
                        <div class="text-muted small">Неуспешных (есть Error)</div>
                        <div class="h3 mb-0 text-danger">@Model.KkaStats.Failed</div>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="h5 mb-3">Сводка по NOVA</h2>
        @if (!string.IsNullOrEmpty(Model.NovaStatsError))
        {
            <div class="alert alert-warning mb-3" role="alert">@Model.NovaStatsError</div>
        }
        <div class="row mb-4">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <div class="text-muted small">Всего записей</div>
                        <div class="h3 mb-0">@Model.NovaStats.Total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted small">Успешных (без Error)</div>
                        <div class="h3 mb-0 text-success">@Model.NovaStats.Successful</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-danger">
                    <div class="card-body">
                        <div class="text-muted small">Неуспешных (есть Error)</div>
                        <div class="h3 mb-0 text-danger">@Model.NovaStats.Failed</div>
                    </div>
                </div>
            </div>
        </div>

        <h2 class="h5 mb-3">Сводка по Remarketing</h2>
        @if (!string.IsNullOrEmpty(Model.RemarketingStatsError))
        {
            <div class="alert alert-warning mb-3" role="alert">@Model.RemarketingStatsError</div>
        }
        <div class="row mb-4">
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-info">
                    <div class="card-body">
                        <div class="text-muted small">Всего записей</div>
                        <div class="h3 mb-0">@Model.RemarketingStats.Total</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2 mb-md-0">
                <div class="card h-100 border-success">
                    <div class="card-body">
                        <div class="text-muted small">Успешных (без Error)</div>
                        <div class="h3 mb-0 text-success">@Model.RemarketingStats.Successful</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-danger">
                    <div class="card-body">
                        <div class="text-muted small">Неуспешных (есть Error)</div>
                        <div class="h3 mb-0 text-danger">@Model.RemarketingStats.Failed</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap">
            <a asp-page="/Kka" class="btn btn-primary mr-2 mb-2">Перейти в ККА</a>
            <a asp-page="/Nova" class="btn btn-primary mr-2 mb-2">Перейти в NOVA</a>
            <a asp-page="/Remarketing" class="btn btn-primary mr-2 mb-2">Перейти в Remarketing</a>
            <a asp-page="/Debug" class="btn btn-outline-secondary mb-2">Открыть Debug</a>
        </div>
    </div>
</div>
